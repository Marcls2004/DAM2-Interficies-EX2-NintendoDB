<?xml version="1.0" encoding="UTF-8"?>

<!-- 
  IMPORTACIONES OBLIGATORIAS DE JAVAFX:
  Le dicen al programa qué componentes gráficos específicos debe cargar en memoria.
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- 
  CONTENEDOR RAÍZ (VBox - Caja Vertical):
  Estructura de forma vertical la pantalla de la ficha que se ve en tu captura de Mario.
  Corregidos los namespaces oficiales (xmlns y xmlns:fx) con sus versiones y rutas completas.
-->
<VBox prefHeight="600.0" prefWidth="380.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.project.Controller">
   <children>
      
      <!-- 
        BARRA SUPERIOR DE LA FICHA (HBox - Caja Horizontal): 
        Coloca el botón para retroceder y el título de la ficha en línea horizontal.
        'alignment="CENTER_LEFT"' los alinea perfectamente al centro vertical de la barra.
      -->
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #EAECEE; -fx-border-color: #BDC3C7; -fx-border-width: 0 0 1px 0;">
         <children>
            <!-- Botón Back: Al pulsarlo, el controlador te hace volver atrás hacia el listado de personajes (fx:id mapeado) -->
            <Button fx:id="btnBackDetall" mnemonicParsing="false" prefHeight="30.0" text="Back" />
            
            <!-- Etiqueta del Título: Su texto cambia dinámicamente en el código Java para mostrar el nombre del personaje clicado -->
            <Label fx:id="lblTitolDetallMobil" text="Detall" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
         <!-- Padding (relleno interior) de 15 píxeles a los lados para separar el botón del borde físico de la pantalla -->
         <padding>
            <Insets left="15.0" right="15.0" />
         </padding>
      </HBox>
      
      <!-- 
        ZONA CENTRAL DE DETALLES MÓVIL (zonaDetallMobil):
        Este es el contenedor elástico vacío. El código del controlador 'Controller.java' inyectará aquí 
        dentro, de forma centrada absoluta ('alignment="CENTER"'), la foto grande de Mario, su texto de juego principal 
        y el cuadradito de color de fondo que vimos en tu captura.
        'VBox.vgrow="ALWAYS"' asegura que este espacio aproveche todo el alto restante de la pantalla del smartphone.
      -->
      <VBox fx:id="zonaDetallMobil" alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      
   </children>
</VBox>
